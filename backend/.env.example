# Copy this file to `.env` and adjust as needed.
# The defaults work for a standard Ollama install on the same machine.

# --- Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# --- Model behaviour ---
# System prompt controls the assistant's personality/rules.
# (Keep it on one line, or set it in config.py instead.)
# SYSTEM_PROMPT=You are a helpful customer support voice assistant...
TEMPERATURE=0.4

# --- Context management ---
# Keep prompts small so the CPU model stays fast. At most N recent turns and
# no more than this many characters of history are sent.
MAX_HISTORY_TURNS=8
MAX_HISTORY_CHARS=4000

# --- Ollama runtime (efficiency) ---
# num_ctx: context window (smaller = faster on CPU). keep_alive: how long the
# model stays warm in RAM between requests (avoids slow cold reloads).
NUM_CTX=2048
KEEP_ALIVE=10m

# --- Web search (Brave Search API) ---
# Optional. Enables live internet answers. Get a free key at:
#   https://api-dashboard.search.brave.com/
# Leave blank to disable web search (everything else still works).
BRAVE_API_KEY=
# How many results to fetch / feed the model, request timeout (seconds), and
# country/language bias for relevance.
SEARCH_RESULTS_COUNT=6
SEARCH_CONTEXT_COUNT=4
SEARCH_TIMEOUT=15
SEARCH_COUNTRY=us
SEARCH_LANG=en

# --- CORS ---
# Comma-separated list of allowed browser origins.
# For local dev you can use "*". In production set your Vercel URL, e.g.:
# CORS_ORIGINS=https://your-app.vercel.app
CORS_ORIGINS=*

# systemd unit for running the backend API on the Oracle server.
#
# Install:
#   sudo cp deploy/ai-support-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ai-support-api
#
# Check:
#   systemctl status ai-support-api
#   journalctl -u ai-support-api -f
#
# Adjust User, WorkingDirectory, and paths to match your server.

[Unit]
Description=AI Audio Support API (FastAPI + Ollama)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/ai-audio-support/backend
# Uses the virtualenv created in the README setup steps.
ExecStart=/home/ubuntu/ai-audio-support/backend/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
